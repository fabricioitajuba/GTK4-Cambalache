<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.2.0 -->
<interface>
  <!-- interface-name Ex01.ui -->
  <requires lib="gtk" version="4.12"/>
  <object class="GtkWindow" id="minha_janela">
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkLabel" id="minha_label"/>
        </child>
        <child>
          <object class="GtkButton" id="meu_botao">
            <property name="height-request">60</property>
            <property name="hexpand">True</property>
            <property name="label">Clique Aqui</property>
            <property name="vexpand">True</property>
            <property name="width-request">200</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
